# ============================================
# Documentation / others (uncomment when needed)
# ============================================
# *.pdf
# *.doc
# *.docx
# *.xls
# *.xlsx
# *.ppt
# *.pptx

# ============================================
# Exceptions: frontend paths that must stay under version control
# ============================================
# frontend/build/ holds the Vite build configuration modules (vite.config.ts depends on ./build),
# it produces no build output, so the backend build/ rule must not ignore it
!frontend/build/
!frontend/build/**
# The frontend .env.* files only hold API addresses and flags, no secrets, and must ship with the repository so a fresh clone runs as is.
# If real secrets are added later, switch to .env.local (already ignored by the rules above).
!frontend/.env
!frontend/.env.development
!frontend/.env.production
!frontend/.env.test