# Application title
VITE_APP_TITLE=RISC-V's AI Cross-Platform Porting Tool
# Storage key prefix
VITE_APP_STORAGE_PREFIX=tongming-portkit-
# Deployment base path (must start and end with /): sets both the Vite base and the router base
VITE_APP_BASE_PATH=/tongming-portkit/
# API path prefix (absolute path on the origin, starting with /): shared by requests and the dev proxy, independent of the deploy path
VITE_API_BASE_PATH=/tongming-portkit-api
# Backend origin (scheme://host:port): used only as the dev server proxy target
VITE_API_BASE_URL=
