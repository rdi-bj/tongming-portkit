{
  "name": "tongming-portkit",
  "type": "module",
  "version": "1.0.0",
  "description": "RISC-V AI cross-platform porting tool — frontend (Vue 3 + Vite + TypeScript)",
  "author": "北京瑞偲创新科技产业有限公司",
  "scripts": {
    "dev": "vite",
    "build:test": "vite build --mode test",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "run-s 'lint:*' format",
    "lint:code": "eslint . --ext .js,.jsx,.ts,.tsx,.vue,.json --fix",
    "lint:type": "vue-tsc -p tsconfig.app.json --noEmit --skipLibCheck",
    "lint:style": "stylelint **/*.{css,scss,vue} --fix",
    "format": "prettier . --write --ignore-unknown",
    "i18n:check": "node scripts/find-i18n-leaks.mjs",
    "up": "pnpx taze minor -wI"
  },
  "dependencies": {
    "@bprogress/core": "^1.3.4",
    "@vueuse/core": "^14.2.1",
    "alova": "^3.5.1",
    "antdv-next": "^1.1.9",
    "d3-force-3d": "^3.0.6",
    "dayjs": "^1.11.20",
    "echarts": "^6.0.0",
    "es-toolkit": "^1.45.1",
    "markdown-it": "^14.2.0",
    "mitt": "^3.0.1",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "three": "^0.184.0",
    "troika-three-text": "^0.52.4",
    "vue": "^3.5.32",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.3.1",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@antdv-next/auto-import-resolver": "^1.0.7",
    "@antdv-next/cssinjs": "^1.0.6",
