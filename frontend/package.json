    "postcss-html": "^1.8.1",
    "postcss-pxtorem": "^6.1.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.1",
    "sass": "^1.99.0",
    "stylelint": "^17.6.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-scss": "^17.0.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "terser": "^5.46.1",
    "typescript": "~6.0.2",
    "unocss": "^66.6.7",
