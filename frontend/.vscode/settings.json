{
  // Default formatter
  "prettier.enable": false,
  "editor.defaultFormatter": "rvest.vs-code-prettier-eslint",
  "[javascript]": {
    "editor.defaultFormatter": "rvest.vs-code-prettier-eslint"
  },
  "[typescript]": {
    "editor.defaultFormatter": "rvest.vs-code-prettier-eslint"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "rvest.vs-code-prettier-eslint"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "rvest.vs-code-prettier-eslint"
  },
  "[vue]": {
    "editor.defaultFormatter": "rvest.vs-code-prettier-eslint"
  },
  // Fix linter errors on save
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit",
    "source.organizeImports": "never"
  },
  // eslint configuration
  "eslint.rules.customizations": [
    { "rule": "style/*", "severity": "off", "fixable": true },
    { "rule": "format/*", "severity": "off", "fixable": true },
    { "rule": "*-indent", "severity": "off", "fixable": true },
    { "rule": "*-spacing", "severity": "off", "fixable": true },
    { "rule": "*-spaces", "severity": "off", "fixable": true },
    { "rule": "*-order", "severity": "off", "fixable": true },
    { "rule": "*-dangle", "severity": "off", "fixable": true },
    { "rule": "*-newline", "severity": "off", "fixable": true },
    { "rule": "*quotes", "severity": "off", "fixable": true },
    { "rule": "*semi", "severity": "off", "fixable": true }
  ],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "html",
    "json",
    "jsonc"
  ],
  // stylelint configuration
  "stylelint.enable": true,
  "stylelint.packageManager": "pnpm",
  "stylelint.validate": ["css", "scss", "vue"],
  // Turn off the built-in validation of these extensions
  "css.validate": false,
  "scss.validate": false,
  // tsdk
  "typescript.tsdk": "./node_modules/typescript/bin",
  // i18n ally
  "i18n-ally.localesPaths": [
    "locales"
  ],
  "i18n-ally.namespace": true,
  "i18n-ally.pathMatcher": "{locale}/{namespace}.json",
  "i18n-ally.annotations": true,
  "i18n-ally.annotationInPlace": false,
  "i18n-ally.displayLanguage": "zh-CN",
  "i18n-ally.enabledParsers": [
    "json"
  ],
  "i18n-ally.keystyle": "nested",
  "i18n-ally.enabledFrameworks": ["vue", "vue-sfc"],
  // Search exclusions
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "pnpm-lock.yaml": true,
    "**/*.svg": true,
    "src/types/generated": true
  },
  // File nesting
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": true,
  "explorer.fileNesting.patterns": {
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "pnpm-lock.yaml, pnpm-workspace.yaml, .browserslistrc",
    ".gitignore": ".gitattributes",
    ".env": ".env.*",
    "eslint.config.js": ".editorconfig, stylelint.config.js, prettier.config.js, .prettierignore, .stylelintignore",
    ".npmrc": ".nvmrc, .node-version",
    "vite.config.ts": "index.html, loading.html",
    "README.md": "CHANGELOG.md, CONTRIBUTING.md, LICENSE, README.md"
  }
}
